# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_ENQUIRY_WEBHOOK: n8n workflow webhook endpoint for property enquiries,
# valuation requests, and viewing bookings.
# Example: https://n8n.yourdomain.com/webhook/Alderwick%26Rowe
VITE_ENQUIRY_WEBHOOK="https://your-n8n-host/webhook/Alderwick%26Rowe"

# VITE_CHAT_WEBHOOK: Dedicated n8n workflow webhook endpoint for interactive chat.
# Falls back to VITE_ENQUIRY_WEBHOOK if not separately defined.
VITE_CHAT_WEBHOOK="https://your-n8n-host/webhook/Alderwick%26Rowe"


